# ==============================================================================
# IMC NeuronKnowledge - Environment Configuration Template
# ==============================================================================
# คัดลอกไฟล์นี้ไปเป็น .env และแก้ไขค่าตามสภาพแวดล้อมของคุณ:
# cp example.env .env

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (จำเป็น / Required)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL
# รูปแบบ: postgresql://[user]:[password]@[host]:[port]/[database]
# ค่า Default หากไม่ระบุ: postgres://postgres:1234@localhost:5432/imc-neuronknowledge
POSTGRES_URL=postgres://postgres:1234@localhost:5432/imc-neuronknowledge


# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (แนะนำอย่างยิ่งสำหรับ Production)
# ------------------------------------------------------------------------------
# Secret key สำหรับ Sign/Verify JSON Web Token (JWT) ทั้งระบบ Authentication และ Core Prompt Lock
# ในระดับ Production ควรใช้สตริงสุ่มที่มีความปลอดภัยสูง (ความยาวอย่างน้อย 32 ตัวอักษร)
# ค่า Default หากไม่ระบุ: neuronknowledge_imc_secure_jwt_secret_key_2026_enterprise
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters


# ------------------------------------------------------------------------------
# 3. CORE PROMPT UNLOCK PASSWORD (จำเป็นเมื่อต้องการแก้ไข Core Prompt ในหน้า Admin)
# ------------------------------------------------------------------------------
# รหัสผ่านสำหรับปลดล็อกการแก้ไข "Core Prompt (หลักการทำงาน)" ใน Admin > System Prompt
# ค่านี้ต้องเป็น Bcrypt Hash ที่ถูกเข้ารหัส Base64 (เพื่อป้องกันไม่ให้ Next.js ขยายค่า $ ใน .env)
# 
# วิธีสร้างค่านี้:
#   รันคำสั่ง: npx tsx scripts/hash-core-password.ts
#   จากนั้นนำค่า CORE_PROMPT_PASSWORD_HASH ที่ได้มาวางที่นี่
CORE_PROMPT_PASSWORD_HASH=


# ------------------------------------------------------------------------------
# 4. OPTIONAL CONFIGURATIONS (ตั้งค่าเพิ่มเติม / ทางเลือก)
# ------------------------------------------------------------------------------
# Timezone สำหรับระบบสถิติการใช้งาน Token และคำถาม (Admin Usage Report)
# ค่า Default หากไม่ระบุ: Asia/Bangkok
USAGE_TIMEZONE=Asia/Bangkok

# Timeout สำหรับการประมวลผลเครื่องมือ MCP (Model Context Protocol) มีหน่วยเป็นมิลลิวินาที (ms)
# ค่า Default หากไม่ระบุ: 600000 (10 นาที)
MCP_TOOL_TIMEOUT_MS=600000

# URL ของระบบแชทที่ใช้งานจริง (imc-chat-aiagent) ใช้กับปุ่ม "ใช้งานจริง" ทั่วทั้งแอป
# หน้า /chat ในแอปนี้เป็นเพียง Test console สำหรับทดสอบ MCP Tools / Agent
# ค่า Default หากไม่ระบุ: https://moc.imcinstitute.com
# หมายเหตุ: ค่า NEXT_PUBLIC_* ถูกฝังตอน build (ต้อง build ใหม่เมื่อเปลี่ยนค่า)
NEXT_PUBLIC_CHAT_URL=https://moc.imcinstitute.com

# Node Environment: 'development' | 'production' | 'test'
# ปกติ Next.js จะตั้งค่าให้อัตโนมัติ (npm run dev = development, npm run start = production)
# NODE_ENV=development
