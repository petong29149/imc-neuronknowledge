# ==============================================================================
# Knowledge Engine - Environment Configuration Template
# ==============================================================================
# คัดลอกไฟล์นี้เป็น .env (ไฟล์ .env ไม่ถูก commit — .gitignore ของ root มี .env*):
#   cp example.env .env
# docker compose อ่าน .env นี้ให้ทุก service (api / worker / mcp / migrate)
# ห้ามตั้งชื่อไฟล์ template ว่า .env.example เพราะจะถูก .gitignore ทิ้ง

# ------------------------------------------------------------------------------
# 1. POSTGRES (จำเป็น)
# ------------------------------------------------------------------------------
# ใช้ database เดียวกับแอป NeuronKnowledge แต่ตารางของ engine อยู่ใน schema แยก (POSTGRES_SCHEMA)
# ใน container ให้ใช้ host.docker.internal แทน localhost เพื่อเข้าถึง Postgres บนเครื่อง host
POSTGRES_URL=postgresql://postgres:1234@host.docker.internal:5432/imc-neuronknowledge
# ถ้ารันด้วย --profile standalone-db (Postgres ใน compose) ให้ใช้แทน:
# POSTGRES_URL=postgresql://postgres:knowledge-dev@postgres:5432/imc-neuronknowledge
# STANDALONE_POSTGRES_PASSWORD=knowledge-dev
POSTGRES_SCHEMA=knowledge

# ------------------------------------------------------------------------------
# 2. INTERNAL API (จำเป็นสำหรับ service api)
# ------------------------------------------------------------------------------
# Token ที่แอป Next.js ใช้เรียก API ภายใน (ต้องตรงกับ KNOWLEDGE_API_TOKEN ของแอป)
# สตริงสุ่มอย่างน้อย 32 ตัวอักษร เช่น: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_TOKEN=
API_PORT=8000

# ------------------------------------------------------------------------------
# 3. QDRANT
# ------------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
# ใส่เมื่อ Qdrant ตั้ง QDRANT__SERVICE__API_KEY ไว้ (เช่น prod / Qdrant Cloud)
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge

# ------------------------------------------------------------------------------
# 4. EMBEDDINGS (จำเป็นตั้งแต่ T8)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small
# เพดาน token ต่อ input นับด้วย cl100k_base (ขีดจำกัดของ model คือ 8191)
EMBED_MAX_TOKENS=8000

# ------------------------------------------------------------------------------
# 5. FILE STORAGE
# ------------------------------------------------------------------------------
# local = เก็บใน volume `files` (/data/files) · s3 = S3 หรือ S3-compatible
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/data/files
S3_ENDPOINT=
S3_BUCKET=knowledge
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_FILE_MB=50

# ------------------------------------------------------------------------------
# 6. CHUNKING / BM25 / THAI TEXT (ปรับจากผล eval ใน T11)
# ------------------------------------------------------------------------------
# นับขนาด chunk ด้วย o200k_base (ภาษาไทยหนาแน่นกว่า cl100k_base ~2.3 เท่า)
CHUNK_ENCODING=o200k_base
CHUNK_MIN_TOKENS=150
CHUNK_TARGET_TOKENS=600
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_SENTENCES=2
BM25_K1=1.2
BM25_B=0.75
BM25_AVGDL=300
GARBLED_THRESHOLD=0.6
# อ่านไฟล์นานเกินนี้ → failed (ต้องน้อยกว่า JOB_STALE_MINUTES)
CONVERT_TIMEOUT_SECONDS=900

# ------------------------------------------------------------------------------
# 6.1 OCR (KNOW-13) — PDF สแกน / หน้าสแกนปน / ไฟล์ JPG, PNG อ่านด้วย OpenAI vision
# ------------------------------------------------------------------------------
# ใช้ OPENAI_API_KEY เดียวกับ embedding · ~$0.002–0.004 ต่อหน้า (gpt-4.1-mini)
# false → ไฟล์สแกนและรูปภาพขึ้นสถานะ "ต้องใช้ OCR" เหมือนเดิม
OCR_ENABLED=true
OCR_MODEL=gpt-4.1-mini
# เอกสารที่มีหน้าต้อง OCR เกินนี้ → ล้มเหลวทันที (กันค่าใช้จ่ายบานปลาย)
OCR_MAX_PAGES=200
# จำนวนหน้าที่ส่งให้ OCR พร้อมกันต่อเอกสาร
OCR_CONCURRENCY=4

# ------------------------------------------------------------------------------
# 7. RERANK (T10)
# ------------------------------------------------------------------------------
# true ต้องใช้ image ที่มี torch: MCP_TARGET=rerank (dev: MCP_DEV_TARGET=dev-rerank)
# โมเดล ~2.3GB โหลดครั้งแรกลง volume hf_cache · CPU ~1–3 วินาที/คำค้น
RERANK_ENABLED=false
MCP_TARGET=base
MCP_DEV_TARGET=dev
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MAX_LENGTH=1024

# ------------------------------------------------------------------------------
# 8. SERVICES
# ------------------------------------------------------------------------------
MCP_PORT=8765
WORKER_POLL_SECONDS=2
JOB_STALE_MINUTES=30
